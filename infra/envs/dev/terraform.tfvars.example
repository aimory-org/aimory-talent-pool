# -----------------------------------------------------------------------------
# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values
# -----------------------------------------------------------------------------

# General
aws_region   = "us-east-1"
project_name = "aimory-talent-pool"
environment  = "dev"  # dev, staging, or prod

# Lambda module variables
presign_api_key    = "your-secure-api-key-min-16-chars"  # Min 16 characters
raw_prefix         = "resumes/raw"
extracted_prefix   = "resumes/extracted"
sfn_arn_param_name = "/aimory-talent-pool/dev/resume-pipeline-arn"

# Deployment history proxy
github_pat_param     = "/aimory/github-pat"
github_repo          = "bencas21/aimory-talent-pool"
github_workflow_file = "merge-deploy.yml"

# Frontend hosting (custom domain)
#
# frontend_hostname drives everything: a delegated Route 53 zone, an ACM cert,
# the CloudFront alias records, and the Cognito + CORS allow-list entries.
# Leave it unset here — the default in variables.tf is the source of truth so
# that CI (which only sees TF_VAR_* env, never this file) agrees with local
# applies. Setup runbook: infra/docs/custom-domain.md
#
# frontend_hostname = "arrow.aimoryconsulting.com"

# Only used when frontend_hostname is null — manual cert/alias wiring.
frontend_domain_aliases  = []  # e.g., ["talent.example.com"]
frontend_certificate_arn = null  # ACM cert ARN if using custom domain

# Cognito callback URLs (add CloudFront URL after first deploy)
cognito_callback_urls = ["http://localhost:5173"]
cognito_logout_urls   = ["http://localhost:5173"]

# Microsoft Entra ID (Azure AD)
# Create an app registration in Entra ID and fill these in
entra_client_id     = "00000000-0000-0000-0000-000000000000"  # Application (client) ID
entra_client_secret = "your-client-secret"                    # Client secret value
entra_tenant_id     = "00000000-0000-0000-0000-000000000000"  # Directory (tenant) ID
